DISCORD_TOKEN=your_discord_bot_token_here

# local (LM Studio) or modal
LLM_BACKEND=local

# Generic sampling. A matching profile in models.json overrides these for its model.
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=20

# Local LM Studio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=mimo-v2.6-distill-qwen-9b-mernik
LOCAL_CONTEXT_TOKENS=4096
LOCAL_MAX_OUTPUT_TOKENS=768

# Modal worker. dash.mjs "Choose model" fills these from models.json; redeploy after changing.
MODAL_MODEL_ID=wepiqx/MiMo-V2.6-Distill-Qwen-9B-GGUF-MERNIK
MODAL_MODEL_FILE=MiMo-V2.6-Distill-Qwen-9B-MERNIK-5100.gguf
MODAL_ENABLE_THINKING=true
MODAL_GPU=L4
MODAL_MAX_MODEL_LEN=32768
MODAL_MAX_OUTPUT_TOKENS=2048
MODAL_SCALEDOWN_SECONDS=60

# Chess (local CPU)
STOCKFISH_PATH=
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
STOCKFISH_MOVE_TIME=0.5
